{
    "name": "uzbek/laravel-sms",
    "description": "Unified SMS sending for Uzbek providers — Eskiz, PlayMobile, TextUp and Sayqal behind a single driver contract.",
    "keywords": [
        "laravel",
        "sms",
        "uzbekistan",
        "eskiz",
        "playmobile",
        "textup",
        "sayqal"
    ],
    "license": "MIT",
    "homepage": "https://github.com/professor93/laravel-sms-uzbekistan",
    "support": {
        "issues": "https://github.com/professor93/laravel-sms-uzbekistan/issues",
        "source": "https://github.com/professor93/laravel-sms-uzbekistan"
    },
    "authors": [
        {
            "name": "Inoyatulloh",
            "email": "mwapftp@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-data": "^4.0",
        "symfony/uid": "^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9|^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Uzbek\\Sms\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Uzbek\\Sms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uzbek\\Sms\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "Uzbek\\Sms\\Facades\\Sms",
                "EskizSms": "Uzbek\\Sms\\Facades\\EskizSms",
                "PlayMobileSms": "Uzbek\\Sms\\Facades\\PlayMobileSms",
                "TextUpSms": "Uzbek\\Sms\\Facades\\TextUpSms",
                "SayqalSms": "Uzbek\\Sms\\Facades\\SayqalSms"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
